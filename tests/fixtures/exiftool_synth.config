# exiftool user-defined tags for writing synthetic RedEdge / M3M test data.
# Namespace URIs were read from real files (docs/ASSUMPTIONS.md, 2026-09-10):
#   Camera    = http://pix4d.com/camera/1.0
#   DLS       = http://micasense.com/DLS/1.0/
#   MicaSense = http://micasense.com/MicaSense/1.0/
#   drone-dji = http://www.dji.com/drone-dji/1.0/   (exiftool built-in table Image::ExifTool::DJI::XMP)
# Usage: exiftool -config tests/fixtures/exiftool_synth.config -XMP-Camera:BandName=Blue ...

%Image::ExifTool::UserDefined::Camera = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-Camera', 2 => 'Camera' },
    NAMESPACE => { 'Camera' => 'http://pix4d.com/camera/1.0' },
    WRITABLE => 'string',
    RigName => { },
    BandName => { },
    CentralWavelength => { Writable => 'real' },
    WavelengthFWHM => { Writable => 'real' },
    ModelType => { },
    PrincipalPoint => { },
    PerspectiveFocalLength => { Writable => 'real' },
    PerspectiveFocalLengthUnits => { },
    PerspectiveDistortion => { List => 'Seq', Writable => 'real' },
    VignettingCenter => { List => 'Seq', Writable => 'real' },
    VignettingPolynomial => { List => 'Seq', Writable => 'real' },
    BandSensitivity => { },
    RigRelatives => { },
    RigCameraIndex => { Writable => 'integer' },
    RigRelativesReferenceRigCameraIndex => { Writable => 'integer' },
    GPSXYAccuracy => { Writable => 'real' },
    GPSZAccuracy => { Writable => 'real' },
    Irradiance => { Writable => 'real' },
    IrradianceYaw => { Writable => 'real' },
    IrradiancePitch => { Writable => 'real' },
    IrradianceRoll => { Writable => 'real' },
    IrradianceExposureTime => { Writable => 'real' },
    IrradianceGain => { Writable => 'real' },
    SunSensor => { Writable => 'real' },
    SunSensorExposureTime => { Writable => 'real' },
    SunSensorYaw => { Writable => 'real' },
    SunSensorPitch => { Writable => 'real' },
    SunSensorRoll => { Writable => 'real' },
    IsNormalized => { Writable => 'integer' },
    BlackCurrent => { Writable => 'real' },
);

%Image::ExifTool::UserDefined::DLS = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-DLS', 2 => 'Camera' },
    NAMESPACE => { 'DLS' => 'http://micasense.com/DLS/1.0/' },
    WRITABLE => 'string',
    Serial => { },
    SwVersion => { },
    CenterWavelength => { Writable => 'real' },
    Bandwidth => { Writable => 'real' },
