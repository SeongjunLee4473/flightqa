    SolarAzimuth => { Writable => 'real' },
    EstimatedDirectLightVector => { List => 'Seq' },
    Yaw => { },
    Pitch => { },
    Roll => { },
);

%Image::ExifTool::UserDefined::MicaSense = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-MicaSense', 2 => 'Camera' },
    NAMESPACE => { 'MicaSense' => 'http://micasense.com/MicaSense/1.0/' },
    WRITABLE => 'string',
    BootTimestamp => { Writable => 'integer' },
    RadiometricCalibration => { List => 'Seq', Writable => 'real' },
    FlightId => { },
    CaptureId => { },
    TriggerMethod => { Writable => 'integer' },
    PressureAlt => { Writable => 'real' },
    DarkRowValue => { List => 'Seq', Writable => 'integer' },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        Camera => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::Camera' },
        },
        DLS => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::DLS' },
        },
        MicaSense => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::MicaSense' },
        },
    },
    # DJI 내장 테이블에 없는 M3M 태그를 추가한다.
    'Image::ExifTool::DJI::XMP' => {
        BandName => { Writable => 'string' },
        ImageSource => { Writable => 'string' },
        CaptureUUID => { Writable => 'string' },
